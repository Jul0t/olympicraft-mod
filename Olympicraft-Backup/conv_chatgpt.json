# 12. Écouteurs d’événements

## `GameListener.java`

```java
package fr.exemple.minijeux.listener;

import fr.exemple.minijeux.MiniJeuxPlugin;
import fr.exemple.minijeux.arena.Arena;
import fr.exemple.minijeux.game.DeACoudreArena;
import org.bukkit.entity.Player;
import org.bukkit.event.EventHandler;
import org.bukkit.event.Listener;
import org.bukkit.event.entity.EntityDamageEvent;
import org.bukkit.event.entity.PlayerDeathEvent;
import org.bukkit.event.player.PlayerMoveEvent;
import org.bukkit.event.player.PlayerQuitEvent;
import org.bukkit.event.player.PlayerRespawnEvent;

public final class GameListener implements Listener {

    private final MiniJeuxPlugin plugin;

    public GameListener(MiniJeuxPlugin plugin) {
        this.plugin = plugin;
    }

    @EventHandler
    public void onMove(PlayerMoveEvent event) {
        if (event.getTo() == null) {
            return;
        }

        if (event.getFrom().getBlockX() == event.getTo().getBlockX()
                && event.getFrom().getBlockY() == event.getTo().getBlockY()
                && event.getFrom().getBlockZ() == event.getTo().getBlockZ()) {
            return;
        }

        Arena arena = plugin.getArenaManager().getArena(event.getPlayer());

        if (arena instanceof DeACoudreArena deACoudreArena) {
            deACoudreArena.handleMovement(event.getPlayer());
        }
    }

    @EventHandler
    public void onDamage(EntityDamageEvent event) {
        if (!(event.getEntity() instanceof Player player)) {
            return;
        }

        Arena arena = plugin.getArenaManager().getArena(player);

        if (arena == null) {
            return;
        }

        if (event.getCause() == EntityDamageEvent.DamageCause.FALL) {
            event.setCancelled(true);
        }
    }

    @EventHandler
    public void onDeath(PlayerDeathEvent event) {
        Player player = event.getEntity();
        Arena arena = plugin.getArenaManager().getArena(player);

        if (arena instanceof DeACoudreArena deACoudreArena) {
            event.getDrops().clear();
            event.setDroppedExp(0);
            deACoudreArena.handleDeath(player);
        }
    }

    @EventHandler
    public void onRespawn(PlayerRespawnEvent event) {
        Arena arena = plugin.getArenaManager().getArena(event.getPlayer());

        if (arena == null) {
            return;
        }

        if (plugin.getArenaManager().getMainLobby() != null) {
            event.setRespawnLocation(
                    plugin.getArenaManager().getMainLobby()
            );
        }
    }

    @EventHandler
    public void onQuit(PlayerQuitEvent event) {
        Arena arena = plugin.getArenaManager().getArena(event.getPlayer());

        if (arena != null) {
            arena.leave(event.getPlayer());
        }
    }
}
