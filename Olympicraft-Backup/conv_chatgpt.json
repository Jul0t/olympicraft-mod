```java
package fr.exemple.minijeux.stats;

import fr.exemple.minijeux.MiniJeuxPlugin;
import org.bukkit.configuration.file.YamlConfiguration;

import java.io.File;
import java.io.IOException;
import java.util.UUID;

public final class StatsManager {

    private final MiniJeuxPlugin plugin;
    private final File file;

    private YamlConfiguration data;

    public StatsManager(MiniJeuxPlugin plugin) {
        this.plugin = plugin;
        this.file = new File(plugin.getDataFolder(), "stats.yml");
    }

    public void load() {
        if (!plugin.getDataFolder().exists()) {
            plugin.getDataFolder().mkdirs();
        }

        data = YamlConfiguration.loadConfiguration(file);
    }

    public synchronized void save() {
        if (data == null) {
            return;
        }

        try {
            data.save(file);
        } catch (IOException exception) {
            plugin.getLogger().severe(
                    "Impossible d'enregistrer stats.yml : "
                            + exception.getMessage()
            );
        }
    }

    public synchronized int getWins(UUID uuid) {
        return data.getInt(uuid + ".wins", 0);
    }

    public synchronized int getLosses(UUID uuid) {
        return data.getInt(uuid + ".losses", 0);
    }

    public synchronized int getSuccessfulJumps(UUID uuid) {
        return data.getInt(uuid + ".successful-jumps", 0);
    }

    public synchronized void addWin(UUID uuid) {
        data.set(uuid + ".wins", getWins(uuid) + 1);
    }

    public synchronized void addLoss(UUID uuid) {
        data.set(uuid + ".losses", getLosses(uuid) + 1);
    }

    public synchronized void addSuccessfulJump(UUID uuid) {
        data.set(
                uuid + ".successful-jumps",
                getSuccessfulJumps(uuid) + 1
        );
    }
}
