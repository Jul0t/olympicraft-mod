# 9. Gestionnaire des arènes

## `ArenaManager.java`

```java
package fr.exemple.minijeux.arena;

import fr.exemple.minijeux.MiniJeuxPlugin;
import fr.exemple.minijeux.game.DeACoudreArena;
import fr.exemple.minijeux.util.LocationUtil;
import org.bukkit.Location;
import org.bukkit.configuration.ConfigurationSection;
import org.bukkit.entity.Player;

import java.util.*;

public final class ArenaManager {

    private final MiniJeuxPlugin plugin;
    private final Map<String, Arena> arenas = new LinkedHashMap<>();

    private Location mainLobby;

    public ArenaManager(MiniJeuxPlugin plugin) {
        this.plugin = plugin;
    }

    public void loadArenas() {
        arenas.clear();

        mainLobby = LocationUtil.deserialize(
                plugin.getConfig().getString("main-lobby", "")
        );

        ConfigurationSection section =
                plugin.getConfig().getConfigurationSection("arenas");

        if (section == null) {
            plugin.getLogger().warning("Aucune arène configurée.");
            return;
        }

        for (String arenaName : section.getKeys(false)) {
            String path = "arenas." + arenaName + ".";
            String type = plugin.getConfig().getString(
                    path + "type",
                    "DE_A_COUDRE"
            );

            boolean enabled = plugin.getConfig().getBoolean(
                    path + "enabled",
                    false
            );

            Location lobby = LocationUtil.deserialize(
                    plugin.getConfig().getString(path + "lobby", "")
            );

            Location jump = LocationUtil.deserialize(
                    plugin.getConfig().getString(path + "jump", "")
            );

            Location spectator = LocationUtil.deserialize(
                    plugin.getConfig().getString(path + "spectator", "")
            );

            int minimumPlayers = plugin.getConfig().getInt(
                    path + "minimum-players",
                    2
            );

            int maximumPlayers = plugin.getConfig().getInt(
                    path + "maximum-players",
                    12
            );

            int countdown = plugin.getConfig().getInt(
                    path + "countdown-seconds",
                    10
            );

            int turnTime = plugin.getConfig().getInt(
                    path + "turn-time-seconds",
                    20
            );

            if (type.equalsIgnoreCase("DE_A_COUDRE")) {
                String poolWorld = plugin.getConfig().getString(
                        path + "pool.world",
                        ""
                );

                int minX = plugin.getConfig().getInt(path + "pool.min-x");
                int minY = plugin.getConfig().getInt(path + "pool.min-y");
                int minZ = plugin.getConfig().getInt(path + "pool.min-z");
                int maxX = plugin.getConfig().getInt(path + "pool.max-x");
                int maxY = plugin.getConfig().getInt(path + "pool.max-y");
                int maxZ = plugin.getConfig().getInt(path + "pool.max-z");

                ArenaState state = enabled
                        ? ArenaState.WAITING
                        : ArenaState.DISABLED;

                DeACoudreArena arena = new DeACoudreArena(
                        plugin,
                        arenaName,
                        state,
                        lobby,
                        jump,
                        spectator,
                        minimumPlayers,
                        maximumPlayers,
                        countdown,
                        turnTime,
                        poolWorld,
                        minX,
                        minY,
                        minZ,
                        maxX,
                        maxY,
                        maxZ
                );

                arenas.put(arenaName.toLowerCase(Locale.ROOT), arena);
            }
        }

        plugin.getLogger().info(
                arenas.size() + " arène(s) chargée(s)."
        );
    }

    public Arena getArena(String name) {
        return arenas.get(name.toLowerCase(Locale.ROOT));
    }

    public Arena getArena(Player player) {
        UUID uuid = player.getUniqueId();

        for (Arena arena : arenas.values()) {
            if (arena.contains(uuid)) {
                return arena;
            }
        }

        return null;
    }

    public Collection<Arena> getArenas() {
        return Collections.unmodifiableCollection(arenas.values());
    }

    public Location getMainLobby() {
        return mainLobby == null ? null : mainLobby.clone();
    }

    public void setMainLobby(Location location) {
        mainLobby = location.clone();

        plugin.getConfig().set(
                "main-lobby",
                LocationUtil.serialize(location)
        );

        plugin.saveConfig();
    }

    public void setArenaLocation(
            String arenaName,
            String locationType,
            Location location
    ) {
        String path = "arenas." + arenaName + "." + locationType;

        plugin.getConfig().set(
                path,
                LocationUtil.serialize(location)
        );

        plugin.saveConfig();
        loadArenas();
    }

    public void shutdown() {
        for (Arena arena : arenas.values()) {
            arena.shutdown();
        }
    }
}
