# 13. Commandes

## `MiniJeuxCommand.java`

```java
package fr.exemple.minijeux.command;

import fr.exemple.minijeux.MiniJeuxPlugin;
import fr.exemple.minijeux.arena.Arena;
import org.bukkit.command.*;
import org.bukkit.entity.Player;

import java.util.ArrayList;
import java.util.List;
import java.util.Locale;

public final class MiniJeuxCommand
        implements CommandExecutor, TabCompleter {

    private final MiniJeuxPlugin plugin;

    public MiniJeuxCommand(MiniJeuxPlugin plugin) {
        this.plugin = plugin;
    }

    @Override
    public boolean onCommand(
            CommandSender sender,
            Command command,
            String label,
            String[] args
    ) {
        if (args.length == 0) {
            sendHelp(sender);
            return true;
        }

        switch (args[0].toLowerCase(Locale.ROOT)) {
            case "list" -> listArenas(sender);
            case "join" -> joinArena(sender, args);
            case "leave" -> leaveArena(sender);
            case "setlobby" -> setLobby(sender);
            case "setarenalobby" -> setArenaLocation(sender, args, "lobby");
            case "setjump" -> setArenaLocation(sender, args, "jump");
            case "setspectator" ->
                    setArenaLocation(sender, args, "spectator");
            case "reload" -> reload(sender);
            default -> sendHelp(sender);
        }

        return true;
    }

    private void listArenas(CommandSender sender) {
        sender.sendMessage(plugin.color("&bArènes disponibles :"));

        for (Arena arena : plugin.getArenaManager().getArenas()) {
            sender.sendMessage(
                    plugin.color(
                            "&8- &e" + arena.getName()
                                    + " &7[" + arena.getGameType() + "]"
                                    + " &f" + arena.getPlayerCount()
                                    + "/" + arena.getMaximumPlayers()
                                    + " &7- " + arena.getState().name()
                    )
            );
        }
    }

    private void joinArena(CommandSender sender, String[] args) {
        if (!(sender instanceof Player player)) {
            sender.sendMessage(plugin.message("player-only"));
            return;
        }

        if (!player.hasPermission("minijeux.join")) {
            player.sendMessage(plugin.message("no-permission"));
            return;
        }

        if (args.length < 2) {
            player.sendMessage(
                    plugin.color("&cUtilisation : /mj join <arène>")
            );
            return;
        }

        Arena arena = plugin.getArenaManager().getArena(args[1]);

        if (arena == null) {
            player.sendMessage(plugin.message("arena-not-found"));
            return;
        }

        arena.join(player);
    }

    private void leaveArena(CommandSender sender) {
        if (!(sender instanceof Player player)) {
            sender.sendMessage(plugin.message("player-only"));
            return;
        }

        Arena arena = plugin.getArenaManager().getArena(player);

        if (arena == null) {
            player.sendMessage(plugin.message("not-in-game"));
            return;
        }

        arena.leave(player);
    }

    private void setLobby(CommandSender sender) {
        if (!(sender instanceof Player player)) {
            sender.sendMessage(plugin.message("player-only"));
            return;
        }

        if (!player.hasPermission("minijeux.admin")) {
            player.sendMessage(plugin.message("no-permission"));
            return;
        }

        plugin.getArenaManager().setMainLobby(player.getLocation());
        player.sendMessage(plugin.color("&aLobby principal enregistré."));
    }

    private void setArenaLocation(
            CommandSender sender,
            String[] args,
            String locationType
    ) {
        if (!(sender instanceof Player player)) {
            sender.sendMessage(plugin.message("player-only"));
            return;
        }

        if (!player.hasPermission("minijeux.admin")) {
            player.sendMessage(plugin.message("no-permission"));
            return;
        }

        if (args.length < 2) {
            player.sendMessage(
                    plugin.color(
                            "&cUtilisation : /mj "
                                    + args[0]
                                    + " <arène>"
                    )
            );
            return;
        }

        Arena arena = plugin.getArenaManager().getArena(args[1]);

        if (arena == null) {
            player.sendMessage(plugin.message("arena-not-found"));
            return;
        }

        plugin.getArenaManager().setArenaLocation(
                arena.getName(),
                locationType,
                player.getLocation()
        );

        player.sendMessage(
                plugin.color(
                        "&aPosition &e" + locationType
                                + " &aenregistrée pour &e"
                                + arena.getName()
                                + "&a."
                )
        );
    }

    private void reload(CommandSender sender) {
        if (!sender.hasPermission("minijeux.admin")) {
            sender.sendMessage(plugin.message("no-permission"));
            return;
        }

        plugin.getArenaManager().shutdown();
        plugin.reloadConfig();
        plugin.getArenaManager().loadArenas();

        sender.sendMessage(plugin.color("&aConfiguration rechargée."));
    }

    private void sendHelp(CommandSender sender) {
        sender.sendMessage(plugin.color("&8&m------------------------"));
        sender.sendMessage(plugin.color("&b&lMiniJeux"));
        sender.sendMessage(plugin.color("&e/mj list &7- Voir les arènes"));
        sender.sendMessage(plugin.color("&e/mj join <arène> &7- Rejoindre"));
        sender.sendMessage(plugin.color("&e/mj leave &7- Quitter"));
        sender.sendMessage(
                plugin.color("&e/mj setlobby &7- Définir le lobby principal")
        );

        if (sender.hasPermission("minijeux.admin")) {
            sender.sendMessage(
                    plugin.color(
                            "&e/mj setarenalobby <arène> &7- Lobby d'arène"
                    )
            );
            sender.sendMessage(
                    plugin.color(
                            "&e/mj setjump <arène> &7- Point de saut"
                    )
            );
            sender.sendMessage(
                    plugin.color(
                            "&e/mj setspectator <arène> &7- Zone d'attente"
                    )
            );
            sender.sendMessage(
                    plugin.color("&e/mj reload &7- Recharger")
            );
        }

        sender.sendMessage(plugin.color("&8&m------------------------"));
    }

    @Override
    public List<String> onTabComplete(
            CommandSender sender,
            Command command,
            String alias,
            String[] args
    ) {
        if (args.length == 1) {
            List<String> suggestions = new ArrayList<>(
                    List.of("list", "join", "leave")
            );

            if (sender.hasPermission("minijeux.admin")) {
                suggestions.add("setlobby");
                suggestions.add("setarenalobby");
                suggestions.add("setjump");
                suggestions.add("setspectator");
                suggestions.add("reload");
            }

            return filter(suggestions, args[0]);
        }

        if (args.length == 2
                && List.of(
                        "join",
                        "setarenalobby",
                        "setjump",
                        "setspectator"
                ).contains(args[0].toLowerCase(Locale.ROOT))) {

            List<String> names = plugin.getArenaManager()
                    .getArenas()
                    .stream()
                    .map(Arena::getName)
                    .toList();

            return filter(names, args[1]);
        }

        return List.of();
    }

    private List<String> filter(List<String> values, String input) {
        String lowerInput = input.toLowerCase(Locale.ROOT);

        return values.stream()
                .filter(value ->
                        value.toLowerCase(Locale.ROOT)
                                .startsWith(lowerInput)
                )
                .toList();
    }
}
