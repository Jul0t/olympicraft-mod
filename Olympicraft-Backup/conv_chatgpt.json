# Étape 7 — Créer les commandes Olympicraft

Crée :

```text
src/main/java/fr/olympicraft/command/OlympicraftCommands.java
```

Contenu :

```java
package fr.olympicraft.command;

import com.mojang.brigadier.CommandDispatcher;
import com.mojang.brigadier.builder.LiteralArgumentBuilder;
import fr.olympicraft.internal.BuildDefaults;
import fr.olympicraft.message.MessageService;
import fr.olympicraft.test.TestModeManager;
import net.minecraft.ChatFormatting;
import net.minecraft.commands.CommandSourceStack;
import net.minecraft.commands.Commands;
import net.minecraft.network.chat.Component;

public final class OlympicraftCommands {

    private OlympicraftCommands() {
    }

    public static void register(
            CommandDispatcher<CommandSourceStack> dispatcher,
            MessageService messages,
            TestModeManager testMode
    ) {
        LiteralArgumentBuilder<CommandSourceStack> root =
                Commands.literal(BuildDefaults.ROOT_COMMAND)
                        .executes(context -> showHelp(
                                context.getSource(),
                                messages,
                                testMode
                        ))

                        .then(Commands.literal("help")
                                .executes(context -> showHelp(
                                        context.getSource(),
                                        messages,
                                        testMode
                                )))

                        .then(Commands.literal("status")
                                .executes(context -> showStatus(
                                        context.getSource(),
                                        messages,
                                        testMode
                                )))

                        .then(Commands.literal("test")
                                .requires(source ->
                                        source.hasPermission(2)
                                )

                                .then(Commands.literal("enable")
                                        .executes(context ->
                                                enableTestMode(
                                                        context.getSource(),
                                                        messages,
                                                        testMode
                                                )
                                        ))

                                .then(Commands.literal("disable")
                                        .executes(context ->
                                                disableTestMode(
                                                        context.getSource(),
                                                        messages,
                                                        testMode
                                                )
                                        ))

                                .then(Commands.literal("status")
                                        .executes(context ->
                                                showTestStatus(
                                                        context.getSource(),
                                                        messages,
                                                        testMode
                                                )
                                        )));

        var rootNode = dispatcher.register(root);

        for (String alias : BuildDefaults.ROOT_COMMAND_ALIASES) {
            if (alias.equalsIgnoreCase(BuildDefaults.ROOT_COMMAND)) {
                continue;
            }

            dispatcher.register(
                    Commands.literal(alias).redirect(rootNode)
            );
        }
    }

    private static int showHelp(
            CommandSourceStack source,
            MessageService messages,
            TestModeManager testMode
    ) {
        source.sendSuccess(messages::header, false);

        sendCommand(
                source,
                "/oc help",
                "Affiche l'aide d'Olympicraft."
        );

        sendCommand(
                source,
                "/oc status",
                "Affiche l'état du mod."
        );

        if (source.hasPermission(2)) {
            sendCommand(
                    source,
                    "/oc test enable",
                    "Active le mode de test."
            );

            sendCommand(
                    source,
                    "/oc test disable",
                    "Désactive le mode de test."
            );

            sendCommand(
                    source,
                    "/oc test status",
                    "Affiche l'état du mode de test."
            );
        }

        messages.sendInfo(
                source,
                "Mode test : "
                        + (testMode.isEnabled()
                        ? "activé"
                        : "désactivé")
        );

        return 1;
    }

    private static int showStatus(
            CommandSourceStack source,
            MessageService messages,
            TestModeManager testMode
    ) {
        source.sendSuccess(messages::header, false);

        messages.sendInfo(
                source,
                "Nom : " + BuildDefaults.MOD_NAME
        );

        messages.sendInfo(
                source,
                "Commande principale : /"
                        + BuildDefaults.ROOT_COMMAND
        );

        messages.sendInfo(
                source,
                "Serveur logique : "
                        + (testMode.isServerAttached()
                        ? "attaché"
                        : "détaché")
        );

        messages.sendInfo(
                source,
                "Mode test : "
                        + (testMode.isEnabled()
                        ? "activé"
                        : "désactivé")
        );

        messages.sendInfo(
                source,
                "Mini-jeux prévus : "
                        + BuildDefaults.DEFAULT_GAME_NAMES.size()
        );

        return 1;
    }

    private static int enableTestMode(
            CommandSourceStack source,
            MessageService messages,
            TestModeManager testMode
    ) {
        if (!testMode.enable()) {
            messages.sendWarning(
                    source,
                    "Le mode test est déjà activé."
            );
            return 0;
        }

        messages.sendSuccess(
                source,
                "Le mode test est maintenant activé."
        );

        return 1;
    }

    private static int disableTestMode(
            CommandSourceStack source,
            MessageService messages,
            TestModeManager testMode
    ) {
        if (!testMode.disable()) {
            messages.sendWarning(
                    source,
                    "Le mode test est déjà désactivé."
            );
            return 0;
        }

        messages.sendSuccess(
                source,
                "Le mode test est maintenant désactivé."
        );

        return 1;
    }

    private static int showTestStatus(
            CommandSourceStack source,
            MessageService messages,
            TestModeManager testMode
    ) {
        messages.sendInfo(
                source,
                "Mode test : "
                        + (testMode.isEnabled()
                        ? "activé"
                        : "désactivé")
        );

        return 1;
    }

    private static void sendCommand(
            CommandSourceStack source,
            String command,
            String description
    ) {
        Component line = Component.empty()
                .append(Component.literal(command)
                        .withStyle(ChatFormatting.AQUA))
                .append(Component.literal(" — ")
                        .withStyle(ChatFormatting.DARK_GRAY))
                .append(Component.literal(description)
                        .withStyle(ChatFormatting.GRAY));

        source.sendSuccess(() -> line, false);
    }
}
```

