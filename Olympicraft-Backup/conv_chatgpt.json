# 11. Commandes initiales

Chemin :

```text
src/main/java/fr/olympicraft/command/OlympicraftCommands.java
```

```java
package fr.olympicraft.command;

import com.mojang.brigadier.CommandDispatcher;
import fr.olympicraft.internal.BuildDefaults;
import fr.olympicraft.message.MessageService;
import fr.olympicraft.test.TestModeManager;
import net.minecraft.commands.CommandBuildContext;
import net.minecraft.commands.CommandSourceStack;
import net.minecraft.commands.Commands;

public final class OlympicraftCommands {

    private OlympicraftCommands() {
    }

    public static void register(
            CommandDispatcher<CommandSourceStack> dispatcher,
            CommandBuildContext buildContext,
            Commands.CommandSelection selection,
            MessageService messages,
            TestModeManager testMode
    ) {
        var root = Commands.literal(BuildDefaults.ROOT_COMMAND)
                .executes(context -> showHelp(
                        context.getSource(),
                        messages,
                        testMode
                ))

                .then(Commands.literal("help")
                        .executes(context -> showHelp(
                                context.getSource(),
                                messages,
                                testMode
                        )))

                .then(Commands.literal("status")
                        .executes(context -> showStatus(
                                context.getSource(),
                                messages,
                                testMode
                        )))

                .then(Commands.literal("config")
                        .requires(source ->
                                source.hasPermission(2)
                        )
                        .then(Commands.literal("reload")
                                .executes(context ->
                                        reloadConfiguration(
                                                context.getSource(),
                                                messages
                                        )
                                )))

                .then(Commands.literal("test")
                        .requires(source ->
                                source.hasPermission(2)
                        )

                        .then(Commands.literal("enable")
                                .executes(context ->
                                        enableTestMode(
                                                context.getSource(),
                                                messages,
                                                testMode
                                        )
                                ))

                        .then(Commands.literal("disable")
                                .executes(context ->
                                        disableTestMode(
                                                context.getSource(),
                                                messages,
                                                testMode
                                        )
                                ))

                        .then(Commands.literal("status")
                                .executes(context ->
                                        showTestStatus(
                                                context.getSource(),
                                                messages,
                                                testMode
                                        )
                                )));

        dispatcher.register(root);

        for (String alias : BuildDefaults.ROOT_COMMAND_ALIASES) {
            if (alias.equalsIgnoreCase(BuildDefaults.ROOT_COMMAND)) {
                continue;
            }

            dispatcher.register(
                    Commands.literal(alias)
                            .redirect(
                                    dispatcher.getRoot()
                                            .getChild(
                                                    BuildDefaults.ROOT_COMMAND
                                            )
                            )
            );
        }
    }

    private static int showHelp(
            CommandSourceStack source,
            MessageService messages,
            TestModeManager testMode
    ) {
        source.sendSuccess(
                messages::commandHeader,
                false
        );

        messages.sendInfo(
                source,
                "§b/oc help §8- §7Affiche cette aide."
        );

        messages.sendInfo(
                source,
                "§b/oc status §8- §7Affiche l'état d'Olympicraft."
        );

        if (source.hasPermission(2)) {
            messages.sendInfo(
                    source,
                    "§b/oc config reload §8- §7Recharge la configuration."
            );

            messages.sendInfo(
                    source,
                    "§b/oc test enable §8- §7Active le mode test."
            );

            messages.sendInfo(
                    source,
                    "§b/oc test disable §8- §7Désactive le mode test."
            );

            messages.sendInfo(
                    source,
                    "§b/oc test status §8- §7Affiche l'état du mode test."
            );
        }

        messages.sendInfo(
                source,
                "Mode test : "
                        + (
                        testMode.isEnabled()
                                ? "§aactivé"
                                : "§cdésactivé"
                )
        );

        return 1;
    }

    private static int showStatus(
            CommandSourceStack source,
            MessageService messages,
            TestModeManager testMode
    ) {
        messages.sendInfo(
                source,
                "Nom : §b" + BuildDefaults.MOD_NAME
        );

        messages.sendInfo(
                source,
                "Serveur logique : "
                        + (
                        testMode.isServerAttached()
                                ? "§aattaché"
                                : "§cdétaché"
                )
        );

        messages.sendInfo(
                source,
                "Mode test : "
                        + (
                        testMode.isEnabled()
                                ? "§aactivé"
                                : "§cdésactivé"
                )
        );

        return 1;
    }

    private static int reloadConfiguration(
            CommandSourceStack source,
            MessageService messages
    ) {
        // Le gestionnaire JSON5 sera branché dans l'étape suivante.
        messages.sendWarning(
                source,
                "Le gestionnaire de configuration sera ajouté "
                        + "dans la prochaine étape."
        );

        return 1;
    }

    private static int enableTestMode(
            CommandSourceStack source,
            MessageService messages,
            TestModeManager testMode
    ) {
        if (!testMode.enable()) {
            messages.sendWarning(
                    source,
                    "Le mode test est déjà activé."
            );
            return 0;
        }

        messages.sendSuccess(
                source,
                "Mode test activé."
        );

        return 1;
    }

    private static int disableTestMode(
            CommandSourceStack source,
            MessageService messages,
            TestModeManager testMode
    ) {
        if (!testMode.disable()) {
            messages.sendWarning(
                    source,
                    "Le mode test est déjà désactivé."
            );
            return 0;
        }

        messages.sendSuccess(
                source,
                "Mode test désactivé."
        );

        return 1;
    }

    private static int showTestStatus(
            CommandSourceStack source,
            MessageService messages,
            TestModeManager testMode
    ) {
        messages.sendInfo(
                source,
                "Le mode test est actuellement "
                        + (
                        testMode.isEnabled()
                                ? "§aactivé§7."
                                : "§cdésactivé§7."
                )
        );

        return 1;
    }
}
```

