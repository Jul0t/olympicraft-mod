    amount: 1
  },
  victory: {
    enabled: true,
    amount: 20
  },
  item_caused_elimination: {
    enabled: true,
    amount: 4,
    attribution_seconds: 10
  },
  layer_survived: {
    enabled: false,
    amount: 2
