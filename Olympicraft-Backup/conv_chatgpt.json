# 7. Classe abstraite des arènes

## `Arena.java`

```java
package fr.exemple.minijeux.arena;

import fr.exemple.minijeux.MiniJeuxPlugin;
import org.bukkit.Bukkit;
import org.bukkit.Location;
import org.bukkit.entity.Player;
import org.bukkit.scheduler.BukkitTask;

import java.util.Collections;
import java.util.LinkedHashSet;
import java.util.Set;
import java.util.UUID;

public abstract class Arena {

    protected final MiniJeuxPlugin plugin;
    protected final String name;

    protected final Set<UUID> players = new LinkedHashSet<>();
    protected final Set<UUID> spectators = new LinkedHashSet<>();

    protected ArenaState state;
    protected Location lobby;
    protected Location spectatorLocation;

    protected final int minimumPlayers;
    protected final int maximumPlayers;
    protected final int countdownSeconds;

    protected BukkitTask countdownTask;
    protected int countdownRemaining;

    protected Arena(
            MiniJeuxPlugin plugin,
            String name,
            ArenaState state,
            Location lobby,
            Location spectatorLocation,
            int minimumPlayers,
            int maximumPlayers,
            int countdownSeconds
    ) {
        this.plugin = plugin;
        this.name = name;
        this.state = state;
        this.lobby = lobby;
        this.spectatorLocation = spectatorLocation;
        this.minimumPlayers = minimumPlayers;
        this.maximumPlayers = maximumPlayers;
        this.countdownSeconds = countdownSeconds;
    }

    public boolean join(Player player) {
        if (state == ArenaState.DISABLED) {
            player.sendMessage(plugin.message("arena-not-found"));
            return false;
        }

        if (state == ArenaState.RUNNING || state == ArenaState.ENDING) {
            player.sendMessage(plugin.message("arena-running"));
            return false;
        }

        if (players.size() >= maximumPlayers) {
            player.sendMessage(plugin.message("arena-full"));
            return false;
        }

        if (plugin.getArenaManager().getArena(player) != null) {
            player.sendMessage(plugin.message("already-in-game"));
            return false;
        }

        players.add(player.getUniqueId());

        if (lobby != null) {
            player.teleport(lobby);
        }

        player.getInventory().clear();
        player.setHealth(player.getMaxHealth());
        player.setFoodLevel(20);
        player.setFireTicks(0);

        broadcast(
                plugin.message("joined")
                        .replace("%arena%", name)
        );

        onJoin(player);

        if (players.size() >= minimumPlayers && state == ArenaState.WAITING) {
            startCountdown();
        }

        return true;
    }

    public void leave(Player player) {
        UUID uuid = player.getUniqueId();

        boolean wasPlaying = players.remove(uuid);
        boolean wasSpectating = spectators.remove(uuid);

        if (!wasPlaying && !wasSpectating) {
            return;
        }

        onLeave(player);

        player.getInventory().clear();
        player.setAllowFlight(false);
        player.setFlying(false);

        Location serverLobby = plugin.getArenaManager().getMainLobby();
        if (serverLobby != null) {
            player.teleport(serverLobby);
        }

        player.sendMessage(plugin.message("left"));

        if (state == ArenaState.STARTING && players.size() < minimumPlayers) {
            cancelCountdown();
        }

        if (state == ArenaState.RUNNING) {
            checkWinner();
        }
    }

    public void startCountdown() {
        if (countdownTask != null || state != ArenaState.WAITING) {
            return;
        }

        state = ArenaState.STARTING;
        countdownRemaining = countdownSeconds;

        countdownTask = Bukkit.getScheduler().runTaskTimer(
                plugin,
                () -> {
                    if (players.size() < minimumPlayers) {
                        cancelCountdown();
                        return;
                    }

                    if (countdownRemaining <= 0) {
                        countdownTask.cancel();
                        countdownTask = null;
                        startGame();
                        return;
                    }

                    if (countdownRemaining <= 5
                            || countdownRemaining == 10
                            || countdownRemaining == 30
                            || countdownRemaining == 60) {

                        broadcast(
                                plugin.message("countdown")
                                        .replace(
                                                "%seconds%",
                                                String.valueOf(countdownRemaining)
                                        )
                        );
                    }

                    countdownRemaining--;
                },
                0L,
                20L
        );
    }

    public void cancelCountdown() {
        if (countdownTask != null) {
            countdownTask.cancel();
            countdownTask = null;
        }

        countdownRemaining = 0;

        if (state != ArenaState.DISABLED) {
            state = ArenaState.WAITING;
        }
    }

    public void broadcast(String message) {
        for (UUID uuid : players) {
            Player player = Bukkit.getPlayer(uuid);
            if (player != null) {
                player.sendMessage(message);
            }
        }

        for (UUID uuid : spectators) {
            Player player = Bukkit.getPlayer(uuid);
            if (player != null) {
                player.sendMessage(message);
            }
        }
    }

    public void addSpectator(Player player) {
        players.remove(player.getUniqueId());
        spectators.add(player.getUniqueId());

        if (spectatorLocation != null) {
            player.teleport(spectatorLocation);
        }

        player.setAllowFlight(true);
        player.setFlying(true);
    }

    public void shutdown() {
        cancelCountdown();

        Set<UUID> allPlayers = new LinkedHashSet<>(players);
        allPlayers.addAll(spectators);

        for (UUID uuid : allPlayers) {
            Player player = Bukkit.getPlayer(uuid);
            if (player != null) {
                leave(player);
            }
        }

        players.clear();
        spectators.clear();
    }

    public abstract String getGameType();

    protected abstract void onJoin(Player player);

    protected abstract void onLeave(Player player);

    protected abstract void startGame();

    protected abstract void checkWinner();

    public String getName() {
        return name;
    }

    public ArenaState getState() {
        return state;
    }

    public int getPlayerCount() {
        return players.size();
    }

    public int getMaximumPlayers() {
        return maximumPlayers;
    }

    public int getMinimumPlayers() {
        return minimumPlayers;
    }

    public Set<UUID> getPlayers() {
        return Collections.unmodifiableSet(players);
    }

    public Set<UUID> getSpectators() {
        return Collections.unmodifiableSet(spectators);
    }

    public boolean contains(UUID uuid) {
        return players.contains(uuid) || spectators.contains(uuid);
    }

    public boolean isPlaying(UUID uuid) {
        return players.contains(uuid);
    }

    public boolean isSpectating(UUID uuid) {
        return spectators.contains(uuid);
    }
}
```

