# 14. PlaceholderAPI

## `MiniJeuxExpansion.java`

```java
package fr.exemple.minijeux.placeholder;

import fr.exemple.minijeux.MiniJeuxPlugin;
import fr.exemple.minijeux.arena.Arena;
import fr.exemple.minijeux.game.DeACoudreArena;
import me.clip.placeholderapi.expansion.PlaceholderExpansion;
import org.bukkit.OfflinePlayer;
import org.bukkit.entity.Player;
import org.jetbrains.annotations.NotNull;

public final class MiniJeuxExpansion extends PlaceholderExpansion {

    private final MiniJeuxPlugin plugin;

    public MiniJeuxExpansion(MiniJeuxPlugin plugin) {
        this.plugin = plugin;
    }

    @Override
    public boolean persist() {
        return true;
    }

    @Override
    public boolean canRegister() {
        return true;
    }

    @Override
    public @NotNull String getIdentifier() {
        return "minijeux";
    }

    @Override
    public @NotNull String getAuthor() {
        return String.join(", ", plugin.getPluginMeta().getAuthors());
    }

    @Override
    public @NotNull String getVersion() {
        return plugin.getPluginMeta().getVersion();
    }

    @Override
    public String onRequest(
            OfflinePlayer offlinePlayer,
            @NotNull String params
    ) {
        if (params.equalsIgnoreCase("total_players")) {
            int total = plugin.getArenaManager()
                    .getArenas()
                    .stream()
                    .mapToInt(Arena::getPlayerCount)
                    .sum();

            return String.valueOf(total);
        }

        if (params.startsWith("arena_")) {
            String[] split = params.split("_", 3);

            if (split.length < 3) {
                return null;
            }

            String arenaName = split[1];
            String value = split[2];

            Arena arena = plugin.getArenaManager().getArena(arenaName);

            if (arena == null) {
                return "";
            }

            return switch (value.toLowerCase()) {
                case "players" ->
                        String.valueOf(arena.getPlayerCount());
                case "max" ->
                        String.valueOf(arena.getMaximumPlayers());
                case "min" ->
                        String.valueOf(arena.getMinimumPlayers());
                case "state" ->
                        arena.getState().name();
                case "type" ->
                        arena.getGameType();
                case "current" -> {
                    if (arena instanceof DeACoudreArena deACoudreArena) {
                        yield deACoudreArena.getCurrentPlayerName();
                    }
                    yield "";
                }
                case "time" -> {
                    if (arena instanceof DeACoudreArena deACoudreArena) {
                        yield String.valueOf(
                                deACoudreArena.getTurnRemaining()
                        );
                    }
                    yield "0";
                }
                default -> null;
            };
        }

        if (offlinePlayer == null) {
            return null;
        }

        if (params.equalsIgnoreCase("wins")) {
            return String.valueOf(
                    plugin.getStatsManager().getWins(
                            offlinePlayer.getUniqueId()
                    )
            );
        }

        if (params.equalsIgnoreCase("losses")) {
            return String.valueOf(
                    plugin.getStatsManager().getLosses(
                            offlinePlayer.getUniqueId()
                    )
            );
        }

        if (params.equalsIgnoreCase("successful_jumps")) {
            return String.valueOf(
                    plugin.getStatsManager().getSuccessfulJumps(
                            offlinePlayer.getUniqueId()
                    )
            );
        }

        if (offlinePlayer.isOnline()) {
            Player player = offlinePlayer.getPlayer();

            if (player != null) {
                Arena arena = plugin.getArenaManager().getArena(player);

                if (params.equalsIgnoreCase("arena")) {
                    return arena == null ? "" : arena.getName();
                }

                if (params.equalsIgnoreCase("game")) {
                    return arena == null ? "" : arena.getGameType();
                }

                if (params.equalsIgnoreCase("state")) {
                    return arena == null
                            ? "NONE"
                            : arena.getState().name();
                }

                if (params.equalsIgnoreCase("spectator")) {
                    return arena != null
                            && arena.isSpectating(player.getUniqueId())
                            ? "true"
                            : "false";
                }
            }
        }

        return null;
    }
}
```

L’appel à `persist()` permet à l’expansion interne de rester enregistrée lors d’un rechargement de PlaceholderAPI. PlaceholderAPI recommande précisément ce modèle d’expansion interne pour les placeholders fournis par son propre plugin. ([wiki.placeholderapi.com](https://wiki.placeholderapi.com/developers/creating-a-placeholderexpansion/?utm_source=openai))

