# 8. Mini-jeu Dé à coudre

## `DeACoudreArena.java`

```java
package fr.exemple.minijeux.game;

import fr.exemple.minijeux.MiniJeuxPlugin;
import fr.exemple.minijeux.arena.Arena;
import fr.exemple.minijeux.arena.ArenaState;
import org.bukkit.*;
import org.bukkit.block.Block;
import org.bukkit.entity.Player;
import org.bukkit.scheduler.BukkitTask;

import java.util.*;

public final class DeACoudreArena extends Arena {

    private final Location jumpLocation;

    private final String poolWorldName;
    private final int minX;
    private final int minY;
    private final int minZ;
    private final int maxX;
    private final int maxY;
    private final int maxZ;

    private final int turnTimeSeconds;

    private final List<UUID> turnOrder = new ArrayList<>();
    private final Set<String> placedBlocks = new HashSet<>();

    private int currentTurnIndex;
    private UUID currentPlayer;
    private boolean currentPlayerJumped;
    private BukkitTask turnTask;
    private int turnRemaining;

    public DeACoudreArena(
            MiniJeuxPlugin plugin,
            String name,
            ArenaState state,
            Location lobby,
            Location jumpLocation,
            Location spectatorLocation,
            int minimumPlayers,
            int maximumPlayers,
            int countdownSeconds,
            int turnTimeSeconds,
            String poolWorldName,
            int minX,
            int minY,
            int minZ,
            int maxX,
            int maxY,
            int maxZ
    ) {
        super(
                plugin,
                name,
                state,
                lobby,
                spectatorLocation,
                minimumPlayers,
                maximumPlayers,
                countdownSeconds
        );

        this.jumpLocation = jumpLocation;
        this.turnTimeSeconds = turnTimeSeconds;
        this.poolWorldName = poolWorldName;

        this.minX = Math.min(minX, maxX);
        this.minY = Math.min(minY, maxY);
        this.minZ = Math.min(minZ, maxZ);

        this.maxX = Math.max(minX, maxX);
        this.maxY = Math.max(minY, maxY);
        this.maxZ = Math.max(minZ, maxZ);
    }

    @Override
    public String getGameType() {
        return "DE_A_COUDRE";
    }

    @Override
    protected void onJoin(Player player) {
        player.setGameMode(GameMode.ADVENTURE);
    }

    @Override
    protected void onLeave(Player player) {
        turnOrder.remove(player.getUniqueId());

        if (Objects.equals(currentPlayer, player.getUniqueId())) {
            stopTurnTask();
            Bukkit.getScheduler().runTaskLater(plugin, this::nextTurn, 20L);
        }
    }

    @Override
    protected void startGame() {
        if (players.size() < minimumPlayers) {
            state = ArenaState.WAITING;
            return;
        }

        state = ArenaState.RUNNING;

        turnOrder.clear();
        turnOrder.addAll(players);
        Collections.shuffle(turnOrder);

        currentTurnIndex = -1;
        currentPlayer = null;
        currentPlayerJumped = false;

        for (UUID uuid : players) {
            Player player = Bukkit.getPlayer(uuid);
            if (player == null) {
                continue;
            }

            player.setGameMode(GameMode.ADVENTURE);
            player.setHealth(player.getMaxHealth());
            player.setFoodLevel(20);
            player.setFireTicks(0);

            if (spectatorLocation != null) {
                player.teleport(spectatorLocation);
            }
        }

        broadcast(plugin.message("game-started"));
        nextTurn();
    }

    public void handleMovement(Player player) {
        if (state != ArenaState.RUNNING) {
            return;
        }

        if (!Objects.equals(currentPlayer, player.getUniqueId())) {
            return;
        }

        if (!currentPlayerJumped
                && jumpLocation != null
                && player.getLocation().getY() < jumpLocation.getY() - 1.0) {
            currentPlayerJumped = true;
        }

        if (!currentPlayerJumped) {
            return;
        }

        Location location = player.getLocation();

        Block feet = location.getBlock();
        Block below = location.clone().subtract(0, 1, 0).getBlock();

        if (isInsidePool(feet.getLocation()) && feet.getType() == Material.WATER) {
            successfulJump(player, feet);
            return;
        }

        if (isInsidePool(below.getLocation()) && below.getType() == Material.WATER) {
            successfulJump(player, below);
            return;
        }

        if (location.getY() < minY - 3) {
            eliminate(player);
        }
    }

    public void handleDeath(Player player) {
        if (state == ArenaState.RUNNING && isPlaying(player.getUniqueId())) {
            eliminate(player);
        }
    }

    private void successfulJump(Player player, Block waterBlock) {
        stopTurnTask();

        String blockKey = blockKey(waterBlock.getLocation());

        if (!placedBlocks.add(blockKey)) {
            eliminate(player);
            return;
        }

        waterBlock.setType(
                Material.values()[
                        new Random().nextInt(Material.values().length)
                ],
                false
        );

        if (!waterBlock.getType().isBlock()
                || waterBlock.getType().isAir()
                || waterBlock.isLiquid()) {
            waterBlock.setType(Material.LIGHT_BLUE_CONCRETE, false);
        }

        plugin.getStatsManager().addSuccessfulJump(player.getUniqueId());

        player.sendMessage(
                plugin.color("&aSaut réussi ! Le bloc d'eau devient solide.")
        );

        if (spectatorLocation != null) {
            player.teleport(spectatorLocation);
        }

        Bukkit.getScheduler().runTaskLater(plugin, this::nextTurn, 20L);
    }

    private void eliminate(Player player) {
        if (!players.contains(player.getUniqueId())) {
            return;
        }

        stopTurnTask();

        players.remove(player.getUniqueId());
        turnOrder.remove(player.getUniqueId());
        spectators.add(player.getUniqueId());

        plugin.getStatsManager().addLoss(player.getUniqueId());

        broadcast(
                plugin.message("eliminated")
                        .replace("%player%", player.getName())
        );

        player.setGameMode(GameMode.SPECTATOR);

        if (spectatorLocation != null) {
            player.teleport(spectatorLocation);
        }

        if (players.size() <= 1) {
            checkWinner();
        } else {
            Bukkit.getScheduler().runTaskLater(plugin, this::nextTurn, 20L);
        }
    }

    private void nextTurn() {
        if (state != ArenaState.RUNNING) {
            return;
        }

        if (players.size() <= 1) {
            checkWinner();
            return;
        }

        turnOrder.removeIf(uuid -> !players.contains(uuid));

        if (turnOrder.isEmpty()) {
            turnOrder.addAll(players);
            Collections.shuffle(turnOrder);
            currentTurnIndex = -1;
        }

        currentTurnIndex++;

        if (currentTurnIndex >= turnOrder.size()) {
            currentTurnIndex = 0;
        }

        currentPlayer = turnOrder.get(currentTurnIndex);
        currentPlayerJumped = false;

        Player player = Bukkit.getPlayer(currentPlayer);

        if (player == null || !player.isOnline()) {
            players.remove(currentPlayer);
            turnOrder.remove(currentPlayer);
            nextTurn();
            return;
        }

        if (jumpLocation == null) {
            plugin.getLogger().warning(
                    "L'arène " + name + " n'a pas de point de saut."
            );
            resetArena();
            return;
        }

        player.setGameMode(GameMode.ADVENTURE);
        player.teleport(jumpLocation);
        player.sendMessage(plugin.message("your-turn"));

        for (UUID uuid : players) {
            if (uuid.equals(currentPlayer)) {
                continue;
            }

            Player waitingPlayer = Bukkit.getPlayer(uuid);
            if (waitingPlayer != null && spectatorLocation != null) {
                waitingPlayer.teleport(spectatorLocation);
            }
        }

        startTurnTimer();
    }

    private void startTurnTimer() {
        stopTurnTask();
        turnRemaining = turnTimeSeconds;

        turnTask = Bukkit.getScheduler().runTaskTimer(
                plugin,
                () -> {
                    if (state != ArenaState.RUNNING || currentPlayer == null) {
                        stopTurnTask();
                        return;
                    }

                    Player player = Bukkit.getPlayer(currentPlayer);
                    if (player == null) {
                        stopTurnTask();
                        nextTurn();
                        return;
                    }

                    if (turnRemaining <= 0) {
                        player.sendMessage(
                                plugin.color("&cTemps écoulé !")
                        );
                        eliminate(player);
                        return;
                    }

                    if (turnRemaining <= 5) {
                        player.sendActionBar(
                                plugin.color(
                                        "&cTemps restant : &e"
                                                + turnRemaining
                                                + " seconde(s)"
                                )
                        );
                    }

                    turnRemaining--;
                },
                0L,
                20L
        );
    }

    private void stopTurnTask() {
        if (turnTask != null) {
            turnTask.cancel();
            turnTask = null;
        }
    }

    @Override
    protected void checkWinner() {
        if (state != ArenaState.RUNNING) {
            return;
        }

        stopTurnTask();

        Player winner = null;

        if (players.size() == 1) {
            UUID winnerId = players.iterator().next();
            winner = Bukkit.getPlayer(winnerId);
        }

        state = ArenaState.ENDING;

        if (winner != null) {
            plugin.getStatsManager().addWin(winner.getUniqueId());

            broadcast(
                    plugin.message("winner")
                            .replace("%player%", winner.getName())
            );
        } else {
            broadcast(plugin.color("&eLa partie se termine sans gagnant."));
        }

        Bukkit.getScheduler().runTaskLater(
                plugin,
                this::resetArena,
                100L
        );
    }

    private void resetArena() {
        stopTurnTask();

        Set<UUID> all = new HashSet<>(players);
        all.addAll(spectators);

        for (UUID uuid : all) {
            Player player = Bukkit.getPlayer(uuid);

            if (player == null) {
                continue;
            }

            player.setGameMode(GameMode.ADVENTURE);
            player.setAllowFlight(false);
            player.setFlying(false);
            player.getInventory().clear();

            Location mainLobby = plugin.getArenaManager().getMainLobby();
            if (mainLobby != null) {
                player.teleport(mainLobby);
            }
        }

        restorePool();

        players.clear();
        spectators.clear();
        turnOrder.clear();
        placedBlocks.clear();

        currentTurnIndex = -1;
        currentPlayer = null;
        currentPlayerJumped = false;

        state = ArenaState.WAITING;
    }

    private void restorePool() {
        World world = Bukkit.getWorld(poolWorldName);

        if (world == null) {
            return;
        }

        for (String key : placedBlocks) {
            String[] split = key.split(":");

            if (split.length != 4) {
                continue;
            }

            if (!world.getName().equals(split[0])) {
                continue;
            }

            try {
                int x = Integer.parseInt(split[1]);
                int y = Integer.parseInt(split[2]);
                int z = Integer.parseInt(split[3]);

                world.getBlockAt(x, y, z).setType(Material.WATER, false);
            } catch (NumberFormatException ignored) {
            }
        }
    }

    private boolean isInsidePool(Location location) {
        if (location.getWorld() == null) {
            return false;
        }

        if (!location.getWorld().getName().equals(poolWorldName)) {
            return false;
        }

        return location.getBlockX() >= minX
                && location.getBlockX() <= maxX
                && location.getBlockY() >= minY
                && location.getBlockY() <= maxY
                && location.getBlockZ() >= minZ
                && location.getBlockZ() <= maxZ;
    }

    private String blockKey(Location location) {
        return location.getWorld().getName()
                + ":" + location.getBlockX()
                + ":" + location.getBlockY()
                + ":" + location.getBlockZ();
    }

    public String getCurrentPlayerName() {
        if (currentPlayer == null) {
            return "";
        }

        OfflinePlayer offlinePlayer = Bukkit.getOfflinePlayer(currentPlayer);
        return offlinePlayer.getName() == null ? "" : offlinePlayer.getName();
    }

    public int getTurnRemaining() {
        return turnRemaining;
    }
}
```

> Remarque : pour une version de production, il vaut mieux choisir une liste fixe de matériaux pour les blocs du Dé à coudre, au lieu de sélectionner un matériau parmi toute l’énumération Bukkit.

Remplace ce passage :

