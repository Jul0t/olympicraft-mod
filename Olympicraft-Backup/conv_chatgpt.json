# 5. Classe principale

## `MiniJeuxPlugin.java`

```java
package fr.exemple.minijeux;

import fr.exemple.minijeux.arena.ArenaManager;
import fr.exemple.minijeux.command.MiniJeuxCommand;
import fr.exemple.minijeux.listener.GameListener;
import fr.exemple.minijeux.placeholder.MiniJeuxExpansion;
import fr.exemple.minijeux.stats.StatsManager;
import org.bukkit.Bukkit;
import org.bukkit.ChatColor;
import org.bukkit.command.PluginCommand;
import org.bukkit.plugin.java.JavaPlugin;

public final class MiniJeuxPlugin extends JavaPlugin {

    private ArenaManager arenaManager;
    private StatsManager statsManager;

    @Override
    public void onEnable() {
        saveDefaultConfig();

        statsManager = new StatsManager(this);
        statsManager.load();

        arenaManager = new ArenaManager(this);
        arenaManager.loadArenas();

        MiniJeuxCommand commandExecutor = new MiniJeuxCommand(this);

        PluginCommand command = getCommand("minijeux");
        if (command != null) {
            command.setExecutor(commandExecutor);
            command.setTabCompleter(commandExecutor);
        }

        Bukkit.getPluginManager().registerEvents(
                new GameListener(this),
                this
        );

        if (Bukkit.getPluginManager().isPluginEnabled("PlaceholderAPI")) {
            new MiniJeuxExpansion(this).register();
            getLogger().info("Compatibilité PlaceholderAPI activée.");
        } else {
            getLogger().info("PlaceholderAPI absent : les placeholders internes sont désactivés.");
        }

        long saveInterval = Math.max(
                20L,
                getConfig().getLong("settings.save-interval-seconds", 300L) * 20L
        );

        Bukkit.getScheduler().runTaskTimerAsynchronously(
                this,
                statsManager::save,
                saveInterval,
                saveInterval
        );

        getLogger().info("MiniJeux est activé pour Paper 1.21.1.");
    }

    @Override
    public void onDisable() {
        if (arenaManager != null) {
            arenaManager.shutdown();
        }

        if (statsManager != null) {
            statsManager.save();
        }
    }

    public ArenaManager getArenaManager() {
        return arenaManager;
    }

    public StatsManager getStatsManager() {
        return statsManager;
    }

    public String message(String path) {
        String prefix = getConfig().getString(
                "messages.prefix",
                "&8[&bMiniJeux&8] "
        );

        String message = getConfig().getString(
                "messages." + path,
                "&cMessage inconnu : " + path
        );

        return color(prefix + message);
    }

    public String color(String text) {
        return ChatColor.translateAlternateColorCodes('&', text);
    }
}
```

